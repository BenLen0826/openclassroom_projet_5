# Copier ce fichier en .env (même dossier) et renseigner les valeurs.
# Le fichier .env est ignoré par Git : ne jamais y commiter de vrais secrets.

DB_URL=jdbc:mysql://localhost:3306/mdd
DB_USERNAME=mdd_user
DB_PASSWORD=changeme

# Au moins 32 caractères. Exemple pour en générer une :
#   openssl rand -base64 48
JWT_SECRET=changeme-changeme-changeme-changeme

# Optionnels (valeurs par défaut indiquées)
# SERVER_PORT=8080
# CORS_ALLOWED_ORIGIN=http://localhost:4200
